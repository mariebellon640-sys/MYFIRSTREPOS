{% extends 'base.html.twig' %}

{% block title %}Mon panier — POISSON VIP{% endblock %}

{% block body %}
    <h1 class="h4 mb-4">Mon panier</h1>

    {% if panier.estVide() %}
        <div class="alert alert-light border">
            Votre panier est vide. <a href="{{ path('app_catalogue') }}">Parcourir le catalogue</a>.
        </div>
    {% else %}
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                            <tr><th>Produit</th><th>Preparation</th><th class="text-center">Quantite</th><th class="text-end">Sous-total</th><th></th></tr>
                            </thead>
                            <tbody>
                            {% for item in panier.items %}
                                <tr>
                                    <td>
                                        <a class="text-decoration-none" href="{{ path('app_produit', {id: item.produit.id}) }}">{{ item.produit.nom }}</a>
                                        <div class="small text-muted">{{ item.produit.prixUnitaire|ariary }} / {{ item.produit.unite.libelle }}</div>
                                    </td>
                                    <td class="small text-muted">{{ item.preparationChoisie ?: 'Standard' }}</td>
                                    <td class="text-center" style="min-width: 10rem;">
                                        <form method="post" action="{{ path('app_panier_quantite', {id: item.id}) }}" class="d-flex gap-1 justify-content-center">
                                            <input type="hidden" name="_token" value="{{ csrf_token('panier_item' ~ item.id) }}">
                                            <input class="form-control form-control-sm" style="max-width:6rem" type="number" name="quantite" min="0" step="0.25" value="{{ item.quantite }}">
                                            <button class="btn btn-sm btn-outline-secondary" type="submit" aria-label="Mettre a jour"><i class="bi bi-arrow-repeat"></i></button>
                                        </form>
                                    </td>
                                    <td class="text-end fw-semibold">{{ item.sousTotal|ariary }}</td>
                                    <td class="text-end">
                                        <form method="post" action="{{ path('app_panier_retirer', {id: item.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('panier_item' ~ item.id) }}">
                                            <button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Retirer"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <form method="post" action="{{ path('app_panier_vider') }}" class="mt-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('panier_vider') }}">
                    <button class="btn btn-link text-danger p-0" type="submit">Vider le panier</button>
                </form>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h2 class="h6 text-uppercase text-muted">Recapitulatif</h2>
                        <div class="d-flex justify-content-between"><span>Articles</span><span>{{ panier.nombreArticles }}</span></div>
                        <div class="d-flex justify-content-between fw-bold fs-5 mt-2"><span>Total produits</span><span>{{ panier.montantProduits|ariary }}</span></div>
                        <p class="small text-muted mt-2 mb-3">Les frais de livraison sont calcules a l'etape suivante selon la zone choisie.</p>
                        <a class="btn btn-marine w-100" href="{{ path('app_commande_valider') }}">Commander</a>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
