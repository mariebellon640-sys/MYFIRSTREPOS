{% extends 'base.html.twig' %}

{% block title %}Mes courses — POISSON VIP{% endblock %}

{% block body %}
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h4 mb-1">Mes courses</h1>
            <p class="text-muted mb-0">{{ livreur.typeVehicule.libelle }}{% if livreur.zoneAffectation %} — zone {{ livreur.zoneAffectation.nomZone }}{% endif %}</p>
        </div>
        <form method="post" action="{{ path('livreur_disponibilite') }}" class="d-flex gap-2">
            <input type="hidden" name="_token" value="{{ csrf_token('disponibilite') }}">
            <select class="form-select form-select-sm" name="statut" aria-label="Disponibilite">
                <option value="DISPONIBLE" {{ livreur.statutDisponibilite.value == 'DISPONIBLE' ? 'selected' }}>Disponible</option>
                <option value="EN_COURSE" {{ livreur.statutDisponibilite.value == 'EN_COURSE' ? 'selected' }}>En course</option>
                <option value="HORS_LIGNE" {{ livreur.statutDisponibilite.value == 'HORS_LIGNE' ? 'selected' }}>Hors ligne</option>
            </select>
            <button class="btn btn-sm btn-marine" type="submit">Mettre a jour</button>
        </form>
    </div>

    <h2 class="h6 text-uppercase text-muted">Itineraire conseille</h2>
    {% for livraison in itineraire %}
        <div class="card shadow-sm mb-3">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <span class="badge bg-marine me-2">{{ loop.index }}</span>
                    <strong>{{ livraison.commande.numeroCommande }}</strong>
                    <div class="small text-muted">{{ livraison.commande.adresseLivraison }}</div>
                </div>
                <span class="badge bg-secondary">{{ livraison.statut.libelle }}</span>
                <a class="btn btn-sm btn-marine" href="{{ path('livreur_course', {id: livraison.id}) }}">Ouvrir</a>
            </div>
        </div>
    {% else %}
        <div class="alert alert-light border">Aucune course active. Passez en « disponible » pour recevoir une affectation.</div>
    {% endfor %}

    <h2 class="h6 text-uppercase text-muted mt-4">Historique</h2>
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light"><tr><th>Commande</th><th>Statut</th><th>Livree le</th></tr></thead>
                <tbody>
                {% for livraison in historique %}
                    <tr>
                        <td>{{ livraison.commande.numeroCommande }}</td>
                        <td>{{ livraison.statut.libelle }}</td>
                        <td class="text-muted">{{ livraison.dateLivraisonEffective ? livraison.dateLivraisonEffective|date('d/m/Y H:i') : '—' }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" class="text-muted">Aucune course realisee.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
