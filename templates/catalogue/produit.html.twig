{% extends 'base.html.twig' %}

{% block title %}{{ produit.nom }} — POISSON VIP{% endblock %}

{% block body %}
    <nav aria-label="Fil d'Ariane">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_catalogue') }}">Catalogue</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_catalogue', {categorie: produit.categorie.id}) }}">{{ produit.categorie.nom }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ produit.nom }}</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="ratio ratio-4x3 bg-light rounded-3 overflow-hidden">
                {% if produit.photoUrl %}
                    <img src="{{ produit.photoUrl }}" class="object-fit-cover" alt="{{ produit.nom }}">
                {% else %}
                    <div class="d-flex align-items-center justify-content-center text-muted"><i class="bi bi-image fs-1"></i></div>
                {% endif %}
            </div>
        </div>

        <div class="col-lg-7">
            <h1 class="h3">{{ produit.nom }}</h1>
            <p class="text-muted">{{ produit.espece }} &middot; vendu par <strong>{{ produit.fournisseur.nomCommercial }}</strong>
                {% if produit.fournisseur.noteMoyenne %}<span class="badge bg-light text-dark"><i class="bi bi-star-fill text-warning"></i> {{ produit.fournisseur.noteMoyenne }}</span>{% endif %}
            </p>

            <p class="fs-3 fw-bold text-marine mb-1">{{ produit.prixUnitaire|ariary }} <span class="fs-6 fw-normal text-muted">/ {{ produit.unite.libelle }}</span></p>

            {% if indice is not null %}
                <div class="mb-3">
                    <div class="d-flex justify-content-between small">
                        <span>Indice de fraicheur</span>
                        <span class="fw-semibold text-{{ couleur_fraicheur(indice) }}">{{ libelle_fraicheur(indice) }} ({{ indice }}/100)</span>
                    </div>
                    <div class="progress jauge-fraicheur">
                        <div class="progress-bar bg-{{ couleur_fraicheur(indice) }}" style="width: {{ indice }}%"></div>
                    </div>
                </div>
            {% endif %}

            {% if produit.description %}<p>{{ produit.description }}</p>{% endif %}

            {% if lot %}
                <div class="card bg-light border-0 mb-3">
                    <div class="card-body d-flex gap-3 align-items-center">
                        <img src="{{ url_qr_code(url('app_tracabilite', {codeLot: lot.codeLot}), 96) }}" width="96" height="96" alt="QR code de tracabilite du lot {{ lot.codeLot }}">
                        <div class="small">
                            <div><strong>Lot</strong> {{ lot.codeLot }}</div>
                            <div><strong>Peche a</strong> {{ lot.lieuPeche }}</div>
                            <div><strong>Capture</strong> {{ lot.dateHeureCapture|date('d/m/Y H:i') }} ({{ lot.heuresDepuisCapture }} h)</div>
                            <a href="{{ path('app_tracabilite', {codeLot: lot.codeLot}) }}">Voir la tracabilite complete</a>
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if produit.stockDisponible > 0 %}
                {% if is_granted('ROLE_CLIENT') %}
                    <form method="post" action="{{ path('app_panier_ajouter', {id: produit.id}) }}" class="row g-2 align-items-end">
                        <input type="hidden" name="_token" value="{{ csrf_token('panier_ajouter' ~ produit.id) }}">
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="quantite">Quantite ({{ produit.unite.libelle }})</label>
                            <input class="form-control" type="number" id="quantite" name="quantite" min="0.25" step="0.25" value="1" max="{{ produit.stockDisponible }}" required>
                        </div>
                        {% if produit.preparations|length > 0 %}
                            <div class="col-6 col-md-4">
                                <label class="form-label" for="preparation">Preparation</label>
                                <select class="form-select" id="preparation" name="preparation">
                                    {% for preparation in produit.preparations %}
                                        <option value="{{ preparation }}">{{ preparation }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% endif %}
                        <div class="col-md-5">
                            <button class="btn btn-marine w-100" type="submit"><i class="bi bi-basket"></i> Ajouter au panier</button>
                        </div>
                    </form>
                {% else %}
                    <a class="btn btn-marine" href="{{ path('app_connexion') }}">Connectez-vous pour commander</a>
                {% endif %}
            {% else %}
                <div class="alert alert-warning mb-0">Ce produit est momentanement en rupture de stock.</div>
            {% endif %}
        </div>
    </div>

    <section class="mt-5">
        <h2 class="h5">Avis clients {% if produit.noteMoyenne %}<span class="badge bg-warning text-dark">{{ produit.noteMoyenne }}/5</span>{% endif %}</h2>
        {% for unAvis in avis %}
            <div class="border-bottom py-3">
                <div class="d-flex justify-content-between">
                    <strong>{{ unAvis.client.utilisateur.prenom }}</strong>
                    <span class="text-warning">{{ '★★★★★'|slice(0, unAvis.note) }}<span class="text-muted">{{ '★★★★★'|slice(0, 5 - unAvis.note) }}</span></span>
                </div>
                <p class="mb-1 small text-muted">{{ unAvis.dateCreation|date('d/m/Y') }}</p>
                {% if unAvis.commentaire %}<p class="mb-1">{{ unAvis.commentaire }}</p>{% endif %}
                {% if app.user and not unAvis.estSignale %}
                    <form method="post" action="{{ path('app_avis_signaler', {id: unAvis.id}) }}" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('signaler' ~ unAvis.id) }}">
                        <button class="btn btn-link btn-sm text-muted p-0" type="submit">Signaler</button>
                    </form>
                {% endif %}
            </div>
        {% else %}
            <p class="text-muted">Aucun avis publie pour ce produit.</p>
        {% endfor %}
    </section>
{% endblock %}
