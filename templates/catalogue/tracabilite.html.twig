{% extends 'base.html.twig' %}

{% block title %}Tracabilite du lot {{ lot.codeLot }} — POISSON VIP{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                        <div>
                            <h1 class="h4 mb-1">Tracabilite du lot</h1>
                            <p class="text-muted mb-0">{{ lot.codeLot }}</p>
                        </div>
                        <img src="{{ url_qr_code(url('app_tracabilite', {codeLot: lot.codeLot})) }}" width="140" height="140" alt="QR code du lot {{ lot.codeLot }}">
                    </div>

                    <hr>

                    <dl class="row mb-0">
                        <dt class="col-sm-4">Produit</dt>
                        <dd class="col-sm-8">{% if lot.produit %}<a href="{{ path('app_produit', {id: lot.produit.id}) }}">{{ lot.produit.nom }}</a> ({{ lot.produit.espece }}){% else %}—{% endif %}</dd>

                        <dt class="col-sm-4">Fournisseur</dt>
                        <dd class="col-sm-8">{{ lot.produit ? lot.produit.fournisseur.nomCommercial : '—' }}</dd>

                        <dt class="col-sm-4">Lieu de peche</dt>
                        <dd class="col-sm-8">{{ lot.lieuPeche }}</dd>

                        <dt class="col-sm-4">Date et heure de capture</dt>
                        <dd class="col-sm-8">{{ lot.dateHeureCapture|date('d/m/Y H:i') }}</dd>

                        <dt class="col-sm-4">Mise en vente</dt>
                        <dd class="col-sm-8">{{ lot.dateHeureMiseEnVente|date('d/m/Y H:i') }}</dd>

                        <dt class="col-sm-4">Quantite de l'arrivage</dt>
                        <dd class="col-sm-8">{{ lot.quantiteKg }} kg</dd>

                        <dt class="col-sm-4">Indice de fraicheur</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-{{ couleur_fraicheur(indice) }}">{{ libelle_fraicheur(indice) }}</span>
                            <span class="text-muted small">{{ indice }}/100 apres {{ lot.heuresDepuisCapture }} h</span>
                        </dd>

                        <dt class="col-sm-4">Statut</dt>
                        <dd class="col-sm-8">{{ lot.estRetire ? 'Retire de la vente' : 'En vente' }}</dd>
                    </dl>
                </div>
            </div>
            <p class="text-muted small mt-3">L'indice de fraicheur decroit depuis l'heure de capture declaree par le fournisseur. Sous le seuil de {{ fraicheur.seuilRetrait }}/100, le lot est automatiquement retire du catalogue.</p>
        </div>
    </div>
{% endblock %}
