{% extends 'base.html.twig' %}

{% block title %}Mes produits — POISSON VIP{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Mes produits</h1>
        <a class="btn btn-marine btn-sm" href="{{ path('fournisseur_produit_nouveau') }}">Nouveau produit</a>
    </div>

    {{ include('fournisseur/_menu.html.twig', {actif: 'produits'}) }}

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                <tr><th>Produit</th><th>Categorie</th><th class="text-end">Prix</th><th class="text-center">Stock</th><th class="text-center">Fraicheur</th><th></th></tr>
                </thead>
                <tbody>
                {% for produit in produits %}
                    <tr>
                        <td>
                            <a class="text-decoration-none" href="{{ path('app_produit', {id: produit.id}) }}">{{ produit.nom }}</a>
                            <div class="small text-muted">{{ produit.espece }}{% if not produit.estActif %} — <span class="text-danger">non publie</span>{% endif %}</div>
                        </td>
                        <td class="small text-muted">{{ produit.categorie.nom }}</td>
                        <td class="text-end">{{ produit.prixUnitaire|ariary }}</td>
                        <td class="text-center" style="min-width: 11rem;">
                            <form method="post" action="{{ path('fournisseur_produit_stock', {id: produit.id}) }}" class="d-flex gap-1 justify-content-center">
                                <input type="hidden" name="_token" value="{{ csrf_token('stock' ~ produit.id) }}">
                                <input class="form-control form-control-sm" style="max-width:6rem" type="number" name="stock" min="0" step="0.25" value="{{ produit.stockDisponible }}">
                                <button class="btn btn-sm btn-outline-secondary" type="submit" aria-label="Mettre a jour le stock"><i class="bi bi-check2"></i></button>
                            </form>
                        </td>
                        <td class="text-center">
                            {% set indice = produit.indiceFraicheur %}
                            {% if indice is not null %}
                                <span class="badge bg-{{ couleur_fraicheur(indice) }}">{{ indice }}</span>
                            {% else %}
                                <span class="text-muted small">—</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('fournisseur_produit_modifier', {id: produit.id}) }}">Modifier</a>
                            <a class="btn btn-sm btn-outline-marine" href="{{ path('fournisseur_arrivage', {id: produit.id}) }}">Declarer un arrivage</a>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-muted">Aucun produit enregistre.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
