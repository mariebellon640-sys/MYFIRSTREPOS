{% extends 'base.html.twig' %}

{% block title %}Fidelite et parrainage — POISSON VIP{% endblock %}

{% block body %}
    <div class="row g-4">
        <div class="col-lg-4">{{ include('compte/_menu.html.twig', {actif: 'fidelite'}) }}</div>
        <div class="col-lg-8">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-body text-center">
                            <i class="bi bi-award fs-1 text-marine"></i>
                            <h1 class="h5 mt-2">Points de fidelite</h1>
                            <p class="display-6 fw-bold text-marine mb-0">{{ client.pointsFidelite }}</p>
                            <p class="small text-muted">Un point est credite par tranche de 1 000 Ar sur les commandes livrees.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-body text-center">
                            <i class="bi bi-people fs-1 text-marine"></i>
                            <h2 class="h5 mt-2">Code de parrainage</h2>
                            <p class="fs-4 fw-bold"><code>{{ client.codeParrainage }}</code></p>
                            <p class="small text-muted">Partagez ce code : il vous sera credite des points a la premiere commande de votre filleul.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
