{% extends 'base.html.twig' %}

{% block title %}Notifications — POISSON VIP{% endblock %}

{% block body %}
    <div class="row g-4">
        <div class="col-lg-4">{{ include('compte/_menu.html.twig', {actif: 'notifications'}) }}</div>
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="h5 mb-0">Notifications</h1>
                <form method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('notifications') }}">
                    <button class="btn btn-sm btn-outline-marine" type="submit">Tout marquer comme lu</button>
                </form>
            </div>

            <div class="list-group shadow-sm">
                {% for notification in notifications %}
                    <div class="list-group-item {{ notification.statutLecture ? '' : 'list-group-item-light' }}">
                        <div class="d-flex justify-content-between">
                            <strong><i class="bi bi-{{ notification.type.icone }}"></i> {{ notification.titre }}</strong>
                            <span class="small text-muted">{{ notification.dateEnvoi|date('d/m/Y H:i') }}</span>
                        </div>
                        <p class="mb-0 small">{{ notification.contenu }}</p>
                        <span class="badge bg-light text-muted">{{ notification.canal.libelle }}</span>
                    </div>
                {% else %}
                    <div class="list-group-item text-muted">Aucune notification.</div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
