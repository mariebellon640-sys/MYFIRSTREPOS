{% extends 'base.html.twig' %}

{% block title %}Mes adresses — POISSON VIP{% endblock %}

{% block body %}
    <div class="row g-4">
        <div class="col-lg-4">{{ include('compte/_menu.html.twig', {actif: 'adresses'}) }}</div>
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="h5 mb-0">Mes adresses de livraison</h1>
                <a class="btn btn-sm btn-marine" href="{{ path('app_compte_adresse_nouvelle') }}">Ajouter</a>
            </div>

            {% for adresse in utilisateur.adresses %}
                <div class="card shadow-sm mb-3">
                    <div class="card-body d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <h2 class="h6 mb-1">{{ adresse.libelle }} {% if adresse.estPrincipale %}<span class="badge bg-marine">Principale</span>{% endif %}</h2>
                            <p class="small text-muted mb-0">
                                {{ adresse.rue ? adresse.rue ~ ', ' }}{{ adresse.quartier }}<br>
                                {{ adresse.zoneLivraison ? adresse.zoneLivraison.nomZone ~ ' — ' ~ adresse.zoneLivraison.commune }}
                                {% if adresse.pointRepere %}<br><em>{{ adresse.pointRepere }}</em>{% endif %}
                            </p>
                        </div>
                        <div class="d-flex gap-2">
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_compte_adresse_modifier', {id: adresse.id}) }}">Modifier</a>
                            <form method="post" action="{{ path('app_compte_adresse_supprimer', {id: adresse.id}) }}" onsubmit="return confirm('Supprimer cette adresse ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('supprimer_adresse' ~ adresse.id) }}">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Supprimer</button>
                            </form>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="alert alert-light border">Aucune adresse enregistree.</div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
