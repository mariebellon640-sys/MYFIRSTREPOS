{% extends 'base.html.twig' %}

{% block title %}Verification du compte — POISSON VIP{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h4 mb-2">Verification du compte</h1>
                    <p class="text-muted small">Saisissez le code a six chiffres envoye par e-mail et par SMS. Il est valable dix minutes.</p>

                    <form method="post">
                        <input type="hidden" name="identifiant" value="{{ identifiant }}">
                        <div class="mb-3">
                            <label class="form-label" for="code">Code de verification</label>
                            <input class="form-control form-control-lg text-center" type="text" id="code" name="code" inputmode="numeric" pattern="\d{6}" maxlength="6" required autofocus>
                        </div>
                        <button class="btn btn-marine w-100" type="submit">Valider</button>
                        <button class="btn btn-link w-100 mt-2" type="submit" name="renvoyer" value="1">Renvoyer un code</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
