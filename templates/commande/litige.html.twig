{% extends 'base.html.twig' %}

{% block title %}Signaler un probleme — POISSON VIP{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h5 mb-1">Signaler un probleme</h1>
                    <p class="text-muted small">Commande {{ commande.numeroCommande }}</p>
                    {{ form_start(formulaire) }}
                    {{ form_row(formulaire.typeLitige) }}
                    {{ form_row(formulaire.description) }}
                    <button class="btn btn-marine" type="submit">Envoyer au support</button>
                    {{ form_end(formulaire) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
