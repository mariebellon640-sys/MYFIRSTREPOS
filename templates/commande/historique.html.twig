{% extends 'base.html.twig' %}

{% block title %}Mes commandes — POISSON VIP{% endblock %}

{% block body %}
    <h1 class="h4 mb-4">Historique de mes commandes</h1>

    {% for commande in commandes %}
        <div class="card shadow-sm mb-3">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <a class="fw-semibold text-decoration-none" href="{{ path('app_commande_detail', {numero: commande.numeroCommande}) }}">{{ commande.numeroCommande }}</a>
                    <div class="small text-muted">{{ commande.dateCommande|date('d/m/Y H:i') }} &middot; {{ commande.lignes|length }} article(s)</div>
                </div>
                <span class="badge bg-{{ commande.statut.couleur }}">{{ commande.statut.libelle }}</span>
                <span class="fw-bold">{{ commande.montantTotal|ariary }}</span>
                <div class="d-flex gap-2">
                    <form method="post" action="{{ path('app_commande_recommander', {numero: commande.numeroCommande}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('recommander' ~ commande.id) }}">
                        <button class="btn btn-sm btn-outline-marine" type="submit">Recommander</button>
                    </form>
                    {% if commande.estAnnulableParClient %}
                        <form method="post" action="{{ path('app_commande_annuler', {numero: commande.numeroCommande}) }}"
                              onsubmit="return confirm('Annuler definitivement cette commande ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('annuler' ~ commande.id) }}">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Annuler</button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-light border">Vous n'avez pas encore passe de commande.</div>
    {% endfor %}
{% endblock %}
