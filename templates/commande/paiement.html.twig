{% extends 'base.html.twig' %}

{% block title %}Paiement de la commande {{ commande.numeroCommande }} — POISSON VIP{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-4 text-center">
                    <i class="bi bi-phone fs-1 text-marine"></i>
                    <h1 class="h4 mt-2">Paiement {{ paiement.modePaiement.libelle }}</h1>
                    <p class="text-muted">Commande {{ commande.numeroCommande }}</p>

                    <p class="fs-3 fw-bold text-marine">{{ paiement.montant|ariary }}</p>
                    <p class="small text-muted">Reference de transaction : <code>{{ paiement.referenceTransaction }}</code></p>

                    <p>Validez la demande de paiement recue sur votre telephone, puis confirmez ci-dessous.</p>

                    <form method="post">
                        <input type="hidden" name="_token" value="{{ csrf_token('paiement' ~ commande.id) }}">
                        <button class="btn btn-marine w-100 mb-2" type="submit">J'ai valide le paiement</button>
                        <button class="btn btn-outline-danger w-100" type="submit" name="annuler" value="1">Abandonner et annuler la commande</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
