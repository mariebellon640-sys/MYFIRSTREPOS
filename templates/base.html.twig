<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="POISSON VIP : commande et livraison de poisson frais et de produits de la mer a Antananarivo.">
    <title>{% block title %}POISSON VIP{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>&#128031;</text></svg>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="{{ asset('css/poissonvip.css') }}" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
</head>
<body class="d-flex flex-column min-vh-100">
<nav class="navbar navbar-expand-lg navbar-dark bg-marine sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold" href="{{ path('app_accueil') }}">
            <i class="bi bi-water"></i> POISSON<span class="text-warning">VIP</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navigation" aria-controls="navigation" aria-expanded="false" aria-label="{{ 'nav.menu'|trans }}">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navigation">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" href="{{ path('app_catalogue') }}">{{ 'nav.catalogue'|trans }}</a></li>
                {% if is_granted('ROLE_CLIENT') %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_commande_historique') }}">{{ 'nav.mes_commandes'|trans }}</a></li>
                {% endif %}
                {% if is_granted('ROLE_FOURNISSEUR') %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('fournisseur_tableau_de_bord') }}">{{ 'nav.espace_fournisseur'|trans }}</a></li>
                {% endif %}
                {% if is_granted('ROLE_LIVREUR') %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('livreur_courses') }}">{{ 'nav.mes_courses'|trans }}</a></li>
                {% endif %}
                {% if is_granted('ROLE_SUPPORT') %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('support_litiges') }}">{{ 'nav.support'|trans }}</a></li>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('admin_tableau_de_bord') }}">{{ 'nav.administration'|trans }}</a></li>
                {% endif %}
            </ul>
            <ul class="navbar-nav align-items-lg-center">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-label="{{ 'nav.langue'|trans }}">
                        <i class="bi bi-translate"></i> {{ app.request.locale|upper }}
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="{{ path('app_langue', {langue: 'fr'}) }}">Francais</a></li>
                        <li><a class="dropdown-item" href="{{ path('app_langue', {langue: 'mg'}) }}">Malagasy</a></li>
                    </ul>
                </li>
                {% if app.user %}
                    <li class="nav-item">
                        <a class="nav-link position-relative" href="{{ path('app_compte_notifications') }}" aria-label="{{ 'nav.notifications'|trans }}">
                            <i class="bi bi-bell"></i>
                            {% set nonLues = notifications_non_lues() %}
                            {% if nonLues > 0 %}<span class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle">{{ nonLues }}</span>{% endif %}
                        </a>
                    </li>
                    {% if is_granted('ROLE_CLIENT') %}
                        <li class="nav-item">
                            <a class="nav-link position-relative" href="{{ path('app_panier') }}" aria-label="{{ 'nav.panier'|trans }}">
                                <i class="bi bi-basket"></i>
                                {% set articles = nombre_articles_panier() %}
                                {% if articles > 0 %}<span class="badge rounded-pill bg-warning text-dark position-absolute top-0 start-100 translate-middle">{{ articles }}</span>{% endif %}
                            </a>
                        </li>
                    {% endif %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i> {{ app.user.prenom }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="{{ path('app_compte') }}">{{ 'nav.mon_profil'|trans }}</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_compte_adresses') }}">{{ 'nav.mes_adresses'|trans }}</a></li>
                            {% if is_granted('ROLE_CLIENT') %}
                                <li><a class="dropdown-item" href="{{ path('app_compte_fidelite') }}">{{ 'nav.fidelite'|trans }}</a></li>
                            {% endif %}
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="{{ path('app_deconnexion') }}">{{ 'nav.deconnexion'|trans }}</a></li>
                        </ul>
                    </li>
                {% else %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_connexion') }}">{{ 'nav.connexion'|trans }}</a></li>
                    <li class="nav-item"><a class="btn btn-warning btn-sm ms-lg-2" href="{{ path('app_inscription') }}">{{ 'nav.inscription'|trans }}</a></li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

<main class="flex-grow-1">
    <div class="container py-4">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </div>
</main>

<footer class="bg-marine text-white-50 py-4 mt-auto">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-5">
                <h6 class="text-white">POISSON VIP</h6>
                <p class="small mb-0">{{ 'pied.accroche'|trans }}</p>
            </div>
            <div class="col-md-3">
                <h6 class="text-white">{{ 'pied.navigation'|trans }}</h6>
                <ul class="list-unstyled small mb-0">
                    <li><a class="link-light text-decoration-none" href="{{ path('app_catalogue') }}">{{ 'nav.catalogue'|trans }}</a></li>
                    <li><a class="link-light text-decoration-none" href="{{ path('app_inscription') }}">{{ 'pied.devenir_fournisseur'|trans }}</a></li>
                    <li><a class="link-light text-decoration-none" href="{{ path('app_mentions_legales') }}">{{ 'pied.mentions_legales'|trans }}</a></li>
                </ul>
            </div>
            <div class="col-md-4">
                <h6 class="text-white">{{ 'pied.contact'|trans }}</h6>
                <p class="small mb-0">Antananarivo, Madagascar<br>support@poissonvip.mg<br>+261 34 00 000 00</p>
            </div>
        </div>
        <hr class="border-secondary">
        <p class="small mb-0">&copy; {{ 'now'|date('Y') }} POISSON VIP. {{ 'pied.droits'|trans }}</p>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
