{% extends 'base.html.twig' %}

{% block title %}Litiges — POISSON VIP{% endblock %}

{% block body %}
    <h1 class="h4 mb-3">Litiges et reclamations</h1>
    {% if is_granted('ROLE_ADMIN') %}{{ include('admin/_menu.html.twig', {actif: 'litiges'}) }}{% endif %}

    {% for litige in ouverts %}
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <div>
                        <strong>{{ litige.commande.numeroCommande }}</strong> — {{ litige.typeLitige.libelle }}
                        <div class="small text-muted">{{ litige.client.utilisateur.nomComplet }} — ouvert le {{ litige.dateOuverture|date('d/m/Y H:i') }}</div>
                    </div>
                    <span class="badge bg-warning text-dark">{{ litige.statut.libelle }}</span>
                </div>

                <p class="mt-3 mb-3">{{ litige.description }}</p>

                <form method="post" action="{{ path('support_litige_traiter', {id: litige.id}) }}" class="row g-2 align-items-end">
                    <input type="hidden" name="_token" value="{{ csrf_token('litige' ~ litige.id) }}">
                    <div class="col-md-5">
                        <label class="form-label" for="reponse{{ litige.id }}">Reponse</label>
                        <textarea class="form-control form-control-sm" id="reponse{{ litige.id }}" name="reponse" rows="2">{{ litige.reponse }}</textarea>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="montant{{ litige.id }}">Remboursement (Ar)</label>
                        <input class="form-control form-control-sm" type="number" min="0" step="100" id="montant{{ litige.id }}" name="montant_rembourse">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="statut{{ litige.id }}">Statut</label>
                        <select class="form-select form-select-sm" id="statut{{ litige.id }}" name="statut">
                            <option value="EN_COURS">En cours</option>
                            <option value="RESOLU">Resolu</option>
                            <option value="REJETE">Rejete</option>
                        </select>
                    </div>
                    <div class="col-md-2"><button class="btn btn-sm btn-marine w-100" type="submit">Enregistrer</button></div>
                </form>
            </div>
        </div>
    {% else %}
        <div class="alert alert-light border">Aucun litige en cours.</div>
    {% endfor %}

    <h2 class="h6 text-uppercase text-muted mt-4">Historique</h2>
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light"><tr><th>Commande</th><th>Type</th><th>Statut</th><th class="text-end">Rembourse</th></tr></thead>
                <tbody>
                {% for litige in clotures %}
                    <tr>
                        <td>{{ litige.commande.numeroCommande }}</td>
                        <td class="small text-muted">{{ litige.typeLitige.libelle }}</td>
                        <td>{{ litige.statut.libelle }}</td>
                        <td class="text-end">{{ litige.montantRembourse ? litige.montantRembourse|ariary : '—' }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="text-muted">Aucun litige clos.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
