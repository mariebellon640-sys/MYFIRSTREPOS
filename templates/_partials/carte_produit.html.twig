{% set indice = produit.indiceFraicheur %}
<div class="card h-100 shadow-sm carte-produit">
    <div class="ratio ratio-4x3 bg-light">
        {% if produit.photoUrl %}
            <img src="{{ produit.photoUrl }}" class="card-img-top object-fit-cover" alt="{{ produit.nom }}">
        {% else %}
            <div class="d-flex align-items-center justify-content-center text-muted"><i class="bi bi-image fs-1"></i></div>
        {% endif %}
    </div>
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <h3 class="h6 card-title mb-1">{{ produit.nom }}</h3>
            {% if indice is not null %}
                <span class="badge bg-{{ couleur_fraicheur(indice) }}" title="Indice de fraicheur : {{ indice }}/100">{{ libelle_fraicheur(indice) }}</span>
            {% endif %}
        </div>
        <p class="text-muted small mb-2">{{ produit.espece }} &middot; {{ produit.fournisseur.nomCommercial }}</p>
        <p class="fw-bold text-marine mb-2">{{ produit.prixUnitaire|ariary }} <span class="fw-normal text-muted small">/ {{ produit.unite.libelle }}</span></p>
        {% if produit.stockDisponible > 0 %}
            <p class="small text-success mb-3"><i class="bi bi-check-circle"></i> {{ produit.stockDisponible }} {{ produit.unite.libelle }} disponibles</p>
        {% else %}
            <p class="small text-danger mb-3"><i class="bi bi-x-circle"></i> Rupture de stock</p>
        {% endif %}
        <a href="{{ path('app_produit', {id: produit.id}) }}" class="btn btn-outline-marine btn-sm mt-auto stretched-link">Voir la fiche</a>
    </div>
</div>
