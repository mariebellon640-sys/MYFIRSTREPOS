{% extends 'base.html.twig' %}

{% block title %}Commandes — POISSON VIP{% endblock %}

{% block body %}
    <h1 class="h4 mb-3">Supervision des commandes</h1>
    {{ include('admin/_menu.html.twig', {actif: 'commandes'}) }}

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light"><tr><th>Numero</th><th>Date</th><th>Client</th><th>Zone</th><th>Statut</th><th class="text-end">Montant</th><th></th></tr></thead>
                <tbody>
                {% for commande in commandes %}
                    <tr>
                        <td>{{ commande.numeroCommande }}</td>
                        <td class="small text-muted">{{ commande.dateCommande|date('d/m/Y H:i') }}</td>
                        <td class="small">{{ commande.client.utilisateur.nomComplet }}</td>
                        <td class="small text-muted">{{ commande.zoneLivraison.nomZone }}</td>
                        <td><span class="badge bg-{{ commande.statut.couleur }}">{{ commande.statut.libelle }}</span></td>
                        <td class="text-end">{{ commande.montantTotal|ariary }}</td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-marine" href="{{ path('admin_commande_detail', {id: commande.id}) }}">Detail</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="text-muted">Aucune commande.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
