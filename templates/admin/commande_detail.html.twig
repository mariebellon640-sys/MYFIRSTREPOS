{% extends 'base.html.twig' %}

{% block title %}Commande {{ commande.numeroCommande }} — Administration{% endblock %}

{% block body %}
    <h1 class="h4 mb-3">Commande {{ commande.numeroCommande }}</h1>
    {{ include('admin/_menu.html.twig', {actif: 'commandes'}) }}

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead class="table-light"><tr><th>Produit</th><th>Fournisseur</th><th class="text-center">Qte</th><th class="text-end">Sous-total</th></tr></thead>
                        <tbody>
                        {% for ligne in commande.lignes %}
                            <tr>
                                <td>{{ ligne.produit.nom }}</td>
                                <td class="small text-muted">{{ ligne.produit.fournisseur.nomCommercial }}</td>
                                <td class="text-center">{{ ligne.quantite }}</td>
                                <td class="text-end">{{ ligne.sousTotal|ariary }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm mb-4"><div class="card-body">
                <h2 class="h6 text-uppercase text-muted">Client et livraison</h2>
                <p class="mb-1">{{ commande.client.utilisateur.nomComplet }} — {{ commande.client.utilisateur.telephone }}</p>
                <p class="mb-1">{{ commande.adresseLivraison }}</p>
                <p class="mb-0">Statut : <span class="badge bg-{{ commande.statut.couleur }}">{{ commande.statut.libelle }}</span></p>
                {% if commande.livraison and commande.livraison.livreur %}
                    <p class="mb-0 mt-2 small text-muted">Livreur : {{ commande.livraison.livreur.utilisateur.nomComplet }}</p>
                {% endif %}
            </div></div>

            <div class="card shadow-sm"><div class="card-body">
                <h2 class="h6 text-uppercase text-muted">Montants</h2>
                <div class="d-flex justify-content-between"><span>Produits</span><span>{{ commande.montantProduits|ariary }}</span></div>
                <div class="d-flex justify-content-between"><span>Livraison</span><span>{{ commande.fraisLivraison|ariary }}</span></div>
                <div class="d-flex justify-content-between"><span>Reduction</span><span>-{{ commande.montantReduction|ariary }}</span></div>
                <hr>
                <div class="d-flex justify-content-between fw-bold"><span>Total</span><span>{{ commande.montantTotal|ariary }}</span></div>
                {% if commande.paiement %}
                    <p class="small text-muted mt-2 mb-0">{{ commande.paiement.modePaiement.libelle }} — {{ commande.paiement.statut.libelle }}</p>
                {% endif %}
            </div></div>
        </div>
    </div>
{% endblock %}
