{% extends 'base.html.twig' %}

{% block title %}Fournisseurs — POISSON VIP{% endblock %}

{% macro tableau(fournisseurs, actions) %}
    <div class="card shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light"><tr><th>Enseigne</th><th>Responsable</th><th>Zone</th><th></th></tr></thead>
                <tbody>
                {% for fournisseur in fournisseurs %}
                    <tr>
                        <td>{{ fournisseur.nomCommercial }}<div class="small text-muted">{{ fournisseur.typeFournisseur.libelle }}</div></td>
                        <td class="small text-muted">{{ fournisseur.utilisateur.nomComplet }}<br>{{ fournisseur.utilisateur.telephone }}</td>
                        <td class="small text-muted">{{ fournisseur.zoneLivraison ? fournisseur.zoneLivraison.nomZone : '—' }}</td>
                        <td class="text-end">
                            <form method="post" action="{{ path('admin_fournisseur_statut', {id: fournisseur.id}) }}" class="d-flex gap-2 justify-content-end">
                                <input type="hidden" name="_token" value="{{ csrf_token('fournisseur' ~ fournisseur.id) }}">
                                {% for action in actions %}
                                    <button class="btn btn-sm btn-outline-{{ action.couleur }}" type="submit" name="statut" value="{{ action.statut }}">{{ action.libelle }}</button>
                                {% endfor %}
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="text-muted">Aucun fournisseur dans cette categorie.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endmacro %}

{% block body %}
    {% import _self as tables %}

    <h1 class="h4 mb-3">Fournisseurs</h1>
    {{ include('admin/_menu.html.twig', {actif: 'fournisseurs'}) }}

    <h2 class="h6 text-uppercase text-muted">En attente de validation</h2>
    {{ tables.tableau(enAttente, [{statut: 'VALIDE', libelle: 'Valider', couleur: 'success'}, {statut: 'REJETE', libelle: 'Rejeter', couleur: 'danger'}]) }}

    <h2 class="h6 text-uppercase text-muted">Valides</h2>
    {{ tables.tableau(valides, [{statut: 'SUSPENDU', libelle: 'Suspendre', couleur: 'danger'}]) }}

    <h2 class="h6 text-uppercase text-muted">Suspendus</h2>
    {{ tables.tableau(suspendus, [{statut: 'VALIDE', libelle: 'Reactiver', couleur: 'success'}]) }}
{% endblock %}
