{% extends 'base.html.twig' %}

{% block title %}Zones de livraison — POISSON VIP{% endblock %}

{% block body %}
    <h1 class="h4 mb-3">Zones de livraison</h1>
    {{ include('admin/_menu.html.twig', {actif: 'zones'}) }}

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light"><tr><th>Zone</th><th>Commune</th><th class="text-end">Frais</th><th class="text-end">Delai</th></tr></thead>
                        <tbody>
                        {% for zone in zones %}
                            <tr>
                                <td>{{ zone.nomZone }}</td>
                                <td class="text-muted">{{ zone.commune }}</td>
                                <td class="text-end">{{ zone.fraisLivraison|ariary }}</td>
                                <td class="text-end">{{ zone.delaiEstimeMinutes }} min</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="4" class="text-muted">Aucune zone parametree.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm"><div class="card-body">
                <h2 class="h6 text-uppercase text-muted">Nouvelle zone</h2>
                <form method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('zone') }}">
                    <div class="mb-2"><label class="form-label" for="nom_zone">Nom</label><input class="form-control form-control-sm" id="nom_zone" name="nom_zone" required></div>
                    <div class="mb-2"><label class="form-label" for="commune">Commune</label><input class="form-control form-control-sm" id="commune" name="commune" required></div>
                    <div class="mb-2"><label class="form-label" for="frais">Frais de livraison (Ar)</label><input class="form-control form-control-sm" type="number" min="0" step="100" id="frais" name="frais" required></div>
                    <div class="mb-3"><label class="form-label" for="delai">Delai estime (min)</label><input class="form-control form-control-sm" type="number" min="10" step="5" id="delai" name="delai" value="60" required></div>
                    <button class="btn btn-sm btn-marine w-100" type="submit">Creer la zone</button>
                </form>
            </div></div>
        </div>
    </div>
{% endblock %}
