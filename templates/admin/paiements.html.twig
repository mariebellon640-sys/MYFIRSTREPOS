{% extends 'base.html.twig' %}

{% block title %}Paiements — POISSON VIP{% endblock %}

{% block body %}
    <h1 class="h4 mb-3">Transactions</h1>
    {{ include('admin/_menu.html.twig', {actif: 'paiements'}) }}

    <div class="row g-3 mb-4">
        {% for total in totaux %}
            <div class="col-6 col-lg-3">
                <div class="card shadow-sm h-100"><div class="card-body">
                    <p class="text-uppercase small text-muted mb-1">{{ total.mode }}</p>
                    <p class="h5 mb-0 text-marine">{{ total.montant|ariary }}</p>
                </div></div>
            </div>
        {% endfor %}
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light"><tr><th>Reference</th><th>Commande</th><th>Mode</th><th>Statut</th><th class="text-end">Montant</th><th>Date</th></tr></thead>
                <tbody>
                {% for paiement in paiements %}
                    <tr>
                        <td class="small"><code>{{ paiement.referenceTransaction ?: '—' }}</code></td>
                        <td class="small">{{ paiement.commande.numeroCommande }}</td>
                        <td class="small text-muted">{{ paiement.modePaiement.libelle }}</td>
                        <td><span class="badge bg-secondary">{{ paiement.statut.libelle }}</span></td>
                        <td class="text-end">{{ paiement.montant|ariary }}</td>
                        <td class="small text-muted">{{ paiement.datePaiement|date('d/m/Y H:i') }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-muted">Aucune transaction.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
