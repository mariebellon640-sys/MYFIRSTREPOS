{% extends 'base.html.twig' %}

{% block title %}Administration — POISSON VIP{% endblock %}

{% block body %}
    <h1 class="h4 mb-3">Pilotage de la plateforme</h1>
    {{ include('admin/_menu.html.twig', {actif: 'tableau'}) }}

    <div class="row g-4 mb-4">
        {% set indicateurs = [
            {libelle: "Chiffre d'affaires", valeur: statistiques.chiffreAffaires|ariary, icone: 'cash-coin'},
            {libelle: 'Commandes', valeur: statistiques.nombreCommandes, icone: 'bag-check'},
            {libelle: 'Clients', valeur: statistiques.nombreClients, icone: 'people'},
            {libelle: 'Panier moyen', valeur: statistiques.panierMoyen|ariary, icone: 'graph-up'}
        ] %}
        {% for indicateur in indicateurs %}
            <div class="col-6 col-lg-3">
                <div class="card shadow-sm h-100"><div class="card-body">
                    <p class="text-uppercase small text-muted mb-1"><i class="bi bi-{{ indicateur.icone }}"></i> {{ indicateur.libelle }}</p>
                    <p class="h4 mb-0 text-marine">{{ indicateur.valeur }}</p>
                </div></div>
            </div>
        {% endfor %}
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100"><div class="card-body">
                <h2 class="h6 text-uppercase text-muted">Produits les plus vendus</h2>
                <ul class="list-unstyled small mb-0">
                    {% for produit in statistiques.produitsLesPlusVendus %}
                        <li class="d-flex justify-content-between border-bottom py-1"><span>{{ produit.nom }}</span><strong>{{ produit.quantite }}</strong></li>
                    {% else %}
                        <li class="text-muted">Aucune vente enregistree.</li>
                    {% endfor %}
                </ul>
            </div></div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm h-100"><div class="card-body">
                <h2 class="h6 text-uppercase text-muted">Zones les plus actives</h2>
                <ul class="list-unstyled small mb-0">
                    {% for zone in statistiques.commandesParZone %}
                        <li class="d-flex justify-content-between border-bottom py-1"><span>{{ zone.zone }}</span><strong>{{ zone.total }}</strong></li>
                    {% else %}
                        <li class="text-muted">Aucune livraison enregistree.</li>
                    {% endfor %}
                </ul>
            </div></div>
        </div>
    </div>

    <h2 class="h6 text-uppercase text-muted mt-4">Dernieres commandes</h2>
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light"><tr><th>Numero</th><th>Client</th><th>Statut</th><th class="text-end">Montant</th><th></th></tr></thead>
                <tbody>
                {% for commande in commandesRecentes %}
                    <tr>
                        <td>{{ commande.numeroCommande }}</td>
                        <td class="text-muted">{{ commande.client.utilisateur.nomComplet }}</td>
                        <td><span class="badge bg-{{ commande.statut.couleur }}">{{ commande.statut.libelle }}</span></td>
                        <td class="text-end">{{ commande.montantTotal|ariary }}</td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-marine" href="{{ path('admin_commande_detail', {id: commande.id}) }}">Detail</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="text-muted">Aucune commande.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
